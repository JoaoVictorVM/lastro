# Example environment for a Lastro checkout. Copy to .env and fill in values locally.
# .env is git-ignored and must never be committed. Only variable names live here.

# Credentials referenced by the profiles in lastro.toml. lastro.toml stores the variable
# names, never the values. `lastro init` generates them; example for a "homolog" profile:
LASTRO_HOMOLOG_USERNAME=
LASTRO_HOMOLOG_PASSWORD=

# Native executor only (`executor = "native"`). Used by the lastro process, never sent to the
# model, the history or the browser process.
# ANTHROPIC_API_KEY=

# Observability only (`[profiles.<name>.observability]` enabled). Keys of the Langfuse project;
# read by the lastro processes, never stored in the history, traces or reports, and never
# passed to external executors.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Optional overrides for the bundled demo. The demo already ships obviously fictitious
# defaults in src/lastro_demo/.env.example; set these only to override them.
# DEMO_AURORA_USER=
# DEMO_AURORA_PASSWORD=
# DEMO_BOREAL_USER=
# DEMO_BOREAL_PASSWORD=
# DEMO_MULTI_USER=
# DEMO_MULTI_PASSWORD=
# Comma-separated list, "all" or "none". Unset means every defect and scenario is active.
# LASTRO_DEMO_DEFECTS=
# LASTRO_DEMO_SCENARIOS=
# LASTRO_DEMO_SEED=
