# Configuração do Lastro para este projeto. Este arquivo pode ser versionado:
# ele guarda apenas nomes de variáveis de ambiente, nunca valores de credenciais.

# Identidade estável do projeto, comum a todos os perfis. Nomeia a pasta do histórico no
# private data root; não altere depois de criada.
project_id = ${project_id}

# Fuso usado para exibir horários (nome IANA). O armazenamento é sempre em UTC.
timezone = "America/Sao_Paulo"

# Executor cuja CLI o lastro doctor procura no PATH.
executor = "claude-code"

# Pasta dos dados privados (sessões, evidências, histórico). O padrão da plataforma fica
# fora do repositório; só descomente para usar outro local, também fora do Git.
# private_data_root = "~/dados-lastro"

# Porta do demo local (lastro demo up). Padrão: 8765.
# [demo]
# port = 8765

# Perfis de ambiente (até 10). Selecione com --profile <nome> quando houver mais de um.
[profiles.${profile_name}]
# URL base do sistema sob teste. A navegação fica restrita a ela.
target_url = ${target_url}
# Página de login usada pela autenticação scriptada.
login_url = ${login_url}
# Identificador do tenant esperado depois do login.
tenant_id = ${tenant_id}
# Nome do tenant exibido em relatórios.
tenant_display_name = ${tenant_id}
# Endpoint que informa a versão do sistema alvo (caminho ou URL). Opcional.
# version_endpoint = "/api/version"
# Entidades que o agente pode tocar.
allowed_entities = []
# Métodos HTTP sempre bloqueados.
denied_methods = ["DELETE"]
# Padrões de endpoints sempre bloqueados.
denied_endpoint_patterns = []

# Nomes das variáveis de ambiente com usuário e senha. Os valores ficam no .env.
[profiles.${profile_name}.credentials]
username_env = ${username_env}
password_env = ${password_env}

# Campos editáveis por entidade. Cada entidade precisa estar em allowed_entities.
[profiles.${profile_name}.editable_fields]
# employee = ["phone", "email"]

# Login scriptado: seletores do formulário de login e da escolha de tenant. Os padrões
# funcionam com o demo; ajuste para o sistema alvo. Nenhum valor de credencial fica aqui.
[profiles.${profile_name}.auth]
username_selector = '[name="username"]'
password_selector = '[name="password"]'
submit_selector = 'button[type="submit"]'
# Seleção de tenant exibida depois do login (usuários com mais de um tenant).
tenant_selector = '[name="tenant"]'
tenant_submit_selector = 'button[type="submit"]'
# Prazo do login em segundos (1 a 60).
timeout_seconds = 15

# Verificação do tenant ativo, na ordem de preferência: api, cookie, jwt, page.
# Perfis com allowed_entities precisam de ao menos um método.
[[profiles.${profile_name}.auth.verification]]
type = "api"
endpoint = "/api/me"
tenant_json_path = "tenant.id"
# Caminho opcional da identidade do usuário na mesma resposta.
# user_json_path = "user.email"
