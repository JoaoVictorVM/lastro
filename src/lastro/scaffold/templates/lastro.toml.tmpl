# Configuração do Lastro para este projeto. Este arquivo pode ser versionado:
# ele guarda apenas nomes de variáveis de ambiente, nunca valores de credenciais.

# Identidade estável do projeto, comum a todos os perfis. Nomeia a pasta do histórico no
# private data root; não altere depois de criada.
project_id = ${project_id}

# Fuso usado para exibir horários (nome IANA). O armazenamento é sempre em UTC.
timezone = "America/Sao_Paulo"

# Executor das missões: claude-code ou codex (CLI externa no PATH) ou native (loop próprio, extra native).
executor = ${executor}

# Pasta dos dados privados (sessões, evidências, histórico). O padrão da plataforma fica
# fora do repositório; só descomente para usar outro local, também fora do Git.
# private_data_root = "~/dados-lastro"

# Porta do demo local (lastro demo up). Padrão: 8765.
# [demo]
# port = 8765

# Perfis de ambiente (até 10). Selecione com --profile <nome> quando houver mais de um.
[profiles.${profile_name}]
# URL base do sistema sob teste. A navegação fica restrita a ela.
target_url = ${target_url}
# Página de login usada pela autenticação scriptada.
login_url = ${login_url}
# Identificador do tenant esperado depois do login.
tenant_id = ${tenant_id}
# Nome do tenant exibido em relatórios.
tenant_display_name = ${tenant_id}
# Perfil público: lastro report export --public mantém tenant, URLs, ids e screenshots.
# Use true somente em alvos sem dados reais, como o demo. Padrão: false (exportação redigida).
public = false
# Endpoint que informa a versão do sistema alvo (caminho ou URL). Opcional.
# version_endpoint = "/api/version"
# Entidades que o agente pode tocar.
allowed_entities = []
# Métodos HTTP sempre bloqueados.
denied_methods = ["DELETE"]
# Padrões de endpoints sempre bloqueados.
denied_endpoint_patterns = []

# Limites de cada run, aplicados pelo servidor de browser (inteiros positivos). Ao atingir
# um limite, escritas são bloqueadas e a run termina com relatório parcial.
[profiles.${profile_name}.run_limits]
# Duração total em minutos, incluindo esperas por aprovação.
max_minutes = 30
# Chamadas de tools do agente (approval_status e end_run não contam).
max_actions = 150
# Tentativas totais da mesma operação que falha, incluindo a primeira.
max_attempts = 3
# Chamadas consecutivas sem evento, página, finding ou proposta nova.
max_no_progress_actions = 10

# Reprodução independente: cada finding suspected é repetido em runs filhas novas, sem o
# raciocínio do explorador, antes de virar confirmed.
[profiles.${profile_name}.reproduction]
# Tentativas por finding (1 a 5) e para findings marcados intermittent (até 7).
attempts = 2
intermittent_attempts = 3
# Teto de cada tentativa; vale o menor entre este valor e run_limits.
max_minutes = 10
max_actions = 50
# same: mesmo executor do explorador. cross: o executor de verifiers, sempre diferente.
mode = "same"
# Pares explorador = verificador usados no modo cross, ex.: { claude-code = "codex" }.
verifiers = {}
# Reproduz automaticamente ao fim de uma run completed; false exige lastro run reproduce.
auto = true

# Nomes das variáveis de ambiente com usuário e senha. Os valores ficam no .env.
[profiles.${profile_name}.credentials]
username_env = ${username_env}
password_env = ${password_env}

# Campos editáveis por entidade. Cada entidade precisa estar em allowed_entities.
[profiles.${profile_name}.editable_fields]
# employee = ["phone", "email"]

# Login scriptado: seletores do formulário de login e da escolha de tenant. Os padrões
# funcionam com o demo; ajuste para o sistema alvo. Nenhum valor de credencial fica aqui.
[profiles.${profile_name}.auth]
username_selector = '[name="username"]'
password_selector = '[name="password"]'
submit_selector = 'button[type="submit"]'
# Seleção de tenant exibida depois do login (usuários com mais de um tenant).
tenant_selector = '[name="tenant"]'
tenant_submit_selector = 'button[type="submit"]'
# Prazo do login em segundos (1 a 60).
timeout_seconds = 15

# Verificação do tenant ativo, na ordem de preferência: api, cookie, jwt, page.
# Perfis com allowed_entities precisam de ao menos um método.
[[profiles.${profile_name}.auth.verification]]
type = "api"
endpoint = "/api/me"
tenant_json_path = "tenant.id"
# Caminho opcional da identidade do usuário na mesma resposta.
# user_json_path = "user.email"

# Sem bindings, a exploração permite somente leitura.
[profiles.${profile_name}.policy]
version = 1
auxiliary_origins = []
bindings = []
rules = []
preauthorized_records = []${native_block}

# Registros criados pelas runs: link de detalhe e limpeza manual por entidade. A entidade
# precisa estar em allowed_entities e ter um binding create. O Lastro nunca exclui registros.
# [profiles.${profile_name}.test_data.entities.employee]
# detail_path = "/employees/{id}"
# cleanup_instructions = "Remova o funcionário pela tela de detalhe."
# cleanup_required = true

# Observabilidade opt-in: uma trace por run enviada ao Langfuse por OTLP. Desligada por padrão;
# requer o extra obs (uv sync --extra obs). `lastro obs up` sobe a stack local, mas não habilita
# nada aqui. As chaves ficam no .env; somente os nomes das variáveis ficam neste arquivo.
# [profiles.${profile_name}.observability]
# enabled = false
# endpoint = "http://localhost:3000/api/public/otel/v1/traces"
# ui_url = "http://localhost:3000"
# langfuse_project_id = "<id do projeto no Langfuse>"
# public_key_env = "LANGFUSE_PUBLIC_KEY"
# secret_key_env = "LANGFUSE_SECRET_KEY"

# Ruídos conhecidos: glob completo e sensível a maiúsculas (* e ?).
[profiles.${profile_name}.oracles]
ignore = []
# ignore = [{ url_path = "/analytics/*" }, { message = "*Known noisy widget*" }]

# Contexto de código opcional para `lastro run start --source`. A raiz vem da variável
# SOURCE_REPO_PATH (.env); só caminhos na allowlist são lidos, e .env*, chaves, appsettings,
# links e binários são sempre negados. Requer git e gitleaks.
# [source]
# allow_paths = ["src/**"]
# base_ref = "origin/main"
