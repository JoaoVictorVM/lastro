{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__lastro__*"
    ],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "PowerShell",
      "Agent",
      "Read",
      "Grep",
      "Glob",
      "mcp__playwright__*",
      "mcp__puppeteer__*",
      "mcp__chrome__*"
    ]
  },
  "allowedMcpServers": [
    {
      "serverName": "lastro"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "lastro-permission-hook"
          }
        ]
      }
    ]
  }
}
