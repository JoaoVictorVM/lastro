# Credenciais fictícias do demo do Lastro. Os valores são falsos de propósito e servem
# como padrão do servidor; defina as mesmas variáveis no ambiente para sobrescrevê-los.
DEMO_AURORA_USER=aurora.teste@example.com
DEMO_AURORA_PASSWORD=senha-falsa-aurora-123
DEMO_BOREAL_USER=boreal.teste@example.com
DEMO_BOREAL_PASSWORD=senha-falsa-boreal-123
# Usuário com acesso às duas clínicas; escolhe a clínica depois do login.
DEMO_MULTI_USER=multi.teste@example.com
DEMO_MULTI_PASSWORD=senha-falsa-multi-123

# Opcionais. Sem definição, todos os defeitos e cenários ficam ativos.
# Lista separada por vírgula, "all" ou "none".
# LASTRO_DEMO_DEFECTS=d01,d02,d03,d04,d05,d06,d07,d08,d09,d10
# LASTRO_DEMO_SCENARIOS=s01,s02
# Semente do sorteio de comportamento intermitente, reiniciada a cada reset.
# LASTRO_DEMO_SEED=20240611
